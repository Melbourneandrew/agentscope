{
  "name": "@agentscope/integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "nx": {
    "targets": {
      "build": {
        "cache": false
      },
      "test": {
        "cache": false
      }
    }
  },
  "agentscopeInternalProcessEntrypoints": "./dist/controller.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild fixtures/claude-code-platform-adapter.mjs --bundle --platform=node --format=esm --outfile=dist/claude-code-platform-adapter.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src *.mjs image-preparation/*.mjs fixtures/*.mjs mockserver-material/*.mjs --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "integration": "node controller.mjs",
    "prepack": "node ../../scripts/refuse-private-package.mjs"
  },
  "dependencies": {
    "@agentscope/destination-langfuse": "workspace:*",
    "@agentscope/harness-claude-code": "workspace:*",
    "@agentscope/harnesses-core": "workspace:*",
    "@agentscope/protocol": "workspace:*",
    "@agentscope/testkit": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}

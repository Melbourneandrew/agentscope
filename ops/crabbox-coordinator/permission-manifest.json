{
  "schemaVersion": 1,
  "cloudflarePermission": "Workers Scripts Write",
  "targetWorker": "agentscope-crabbox-development",
  "ordinaryMutationActions": [
    "worker.deploy",
    "worker.rollback",
    "worker.secret.put",
    "worker.secret.delete"
  ],
  "separateOwnerPlanActions": ["account.workersDev.enable"],
  "retirementOnlyActions": [
    "worker.schedule.delete",
    "worker.scriptWorkersDev.disable",
    "worker.terminalArtifact.deploy",
    "worker.version.delete",
    "worker.delete"
  ],
  "forbiddenActions": [
    "worker.domain.create",
    "worker.domain.update",
    "worker.domain.delete",
    "worker.liveTail.create",
    "worker.unrelatedSecret.write",
    "worker.durableObjectClass.rename",
    "worker.durableObjectClass.transfer",
    "zone.route.create",
    "zone.route.update",
    "zone.route.delete",
    "pages.binding.create",
    "access.application.create",
    "sharedStorage.bind"
  ],
  "observableProjections": [
    "workers",
    "workerVersions",
    "workerDeployments",
    "scriptWorkersDev",
    "accountWorkersDev",
    "workerDomains",
    "scheduledTriggers",
    "secretNameSets",
    "logpush",
    "observability",
    "tailConsumers",
    "cacheAndScriptSettings",
    "durableObjectNamespaces",
    "durableObjectBindings",
    "durableObjectMigrations",
    "durableObjectDeletionTombstones",
    "durableObjectRenames",
    "durableObjectTransfers"
  ],
  "writeOnlyOrTransientActions": [
    "worker.secret.put",
    "worker.liveTail.create",
    "worker.durableObjectClass.delete",
    "worker.durableObjectClass.rename",
    "worker.durableObjectClass.transfer"
  ]
}

{
  "name": "@agentscope/destination-local-sqlite",
  "version": "0.1.0",
  "description": "Internal local SQLite trace destination for Agentscope.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter/index.d.ts",
      "import": "./dist/reporter/index.js"
    },
    "./retriever": {
      "types": "./dist/retriever/public.d.ts",
      "import": "./dist/retriever/public.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/clean-workspace.mjs && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs && node --unhandled-rejections=strict verify-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src verify-artifact.mjs native-candidate/verify-artifact.mjs native-candidate/tooling --max-warnings=0",
    "test": "vitest run --config ../../../vitest.config.ts",
    "coverage": "vitest run --config ../../../vitest.config.ts --coverage",
    "clean": "node ../../../scripts/clean-workspace.mjs",
    "prepack": "node ../../../scripts/refuse-private-package.mjs"
  },
  "dependencies": {
    "@agentscope/destinations-core": "workspace:*",
    "@agentscope/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "zod": "^4.3.6"
  }
}

{
  "name": "@agentscope/testkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/clean-workspace.mjs --build-outputs && tsc -p tsconfig.build.json && node verify-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "eslint src --max-warnings=0",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "prepack": "node ../../scripts/refuse-private-package.mjs"
  },
  "dependencies": {
    "@agentscope/destinations-core": "workspace:*",
    "@agentscope/harnesses-core": "workspace:*",
    "@agentscope/protocol": "workspace:*"
  }
}

{
  "name": "@agentscope/protocol",
  "version": "0.1.0",
  "description": "Internal canonical OpenTelemetry and OpenInference trace protocol for Agentscope.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core-finalization": {
      "types": "./dist/core-finalization.d.ts",
      "import": "./dist/core-finalization.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/check-codecs.mjs && tsc -p tsconfig.build.json && node verify-artifact.mjs",
    "generate:codecs": "buf generate --template buf.gen.yaml",
    "check:codecs": "node scripts/check-codecs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts verify-artifact.mjs --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "prepack": "node ../../scripts/refuse-private-package.mjs"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "2.7.0",
    "@bufbuild/protobuf": "2.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}

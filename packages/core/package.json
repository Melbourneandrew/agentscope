{
  "name": "@agentscope/core",
  "version": "0.1.0",
  "description": "Internal Agentscope application orchestration.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./native-traces": "./dist/native-traces/index.js",
    "./native-turns": "./dist/native-turns/index.js",
    "./agent-trace": "./dist/agent-trace/index.js",
    "./testing": "./dist/testing/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melbourneandrew/agentscope.git"
  },
  "dependencies": {
    "@agentscope/destinations-core": "workspace:*",
    "@agentscope/protocol": "workspace:*",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "eslint src --max-warnings=0",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "prepack": "node ../../scripts/refuse-private-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}

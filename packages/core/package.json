{
  "name": "@agentscope/core",
  "version": "0.1.0",
  "description": "Internal Agentscope application orchestration.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness-capture": {
      "types": "./dist/capture/index.d.ts",
      "import": "./dist/capture/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melbourneandrew/agentscope.git"
  },
  "dependencies": {
    "@agentscope/destinations-core": "workspace:*",
    "@agentscope/protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node verify-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "eslint src --max-warnings=0",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "prepack": "node ../../scripts/refuse-private-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2"
  }
}

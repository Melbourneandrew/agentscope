{
  "name": "@agentscope/harnesses-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal shared contracts for first-party Agentscope harnesses.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli-management": {
      "types": "./dist/management-index.d.ts",
      "import": "./dist/management-index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "scripts": {
    "build": "node ../../../scripts/clean-workspace.mjs --build-outputs && tsc -p tsconfig.build.json && node --unhandled-rejections=strict verify-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ../../../vitest.config.ts",
    "coverage": "vitest run --config ../../../vitest.config.ts --coverage",
    "clean": "node ../../../scripts/clean-workspace.mjs",
    "prepack": "node ../../../scripts/refuse-private-package.mjs"
  },
  "dependencies": {
    "@agentscope/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}

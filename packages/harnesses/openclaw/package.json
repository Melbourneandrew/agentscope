  },
  "dependencies": {
    "@agentscope/core": "workspace:*",
    "@agentscope/harnesses-core": "workspace:*",
    "@agentscope/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

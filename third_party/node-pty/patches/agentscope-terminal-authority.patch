+static bool
+pty_close_inherited_fds_except(int preserved_fd) {
+  DIR *directory = opendir("/proc/self/fd");
+  if (directory == nullptr)
+    return false;
+  int directory_fd = dirfd(directory);
+  bool complete = true;
+  struct dirent *entry;
+  errno = 0;
+  while ((entry = readdir(directory)) != nullptr) {
+    char *end = nullptr;
+    long candidate = strtol(entry->d_name, &end, 10);
+    if (end == entry->d_name || *end != '\0' || candidate < 3 ||
+        candidate == preserved_fd || candidate == directory_fd)
+      continue;
+    if (candidate > INT_MAX || SetCloseOnExec(static_cast<int>(candidate)) == -1) {
+      complete = false;
+      break;
+    }
+  }
+  if (errno != 0)
+    complete = false;
+  if (closedir(directory) == -1)
+    complete = false;
+  return complete;
+}

+Napi::Value PtyInspect(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  if (info.Length() != 1 || !info[0].IsNumber())
+    throw Napi::Error::New(env, "Usage: pty.inspect(fd)");
+  int fd = info[0].As<Napi::Number>().Int32Value();
+  struct winsize size;
+  struct termios mode;
+  if (isatty(fd) != 1 || ioctl(fd, TIOCGWINSZ, &size) == -1 ||
+      tcgetattr(fd, &mode) == -1)
+    throw Napi::Error::New(env, "PTY terminal inspection failed");
+  Napi::Object result = Napi::Object::New(env);
+  result.Set("isTTY", Napi::Boolean::New(env, true));
+  result.Set("columns", Napi::Number::New(env, size.ws_col));
+  result.Set("rows", Napi::Number::New(env, size.ws_row));
+  result.Set("canonical", Napi::Boolean::New(env, (mode.c_lflag & ICANON) != 0));
+  result.Set("eofByte", Napi::Number::New(env, mode.c_cc[VEOF]));
+  return result;
+}
+
+Napi::Value PtyRead(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  if (info.Length() != 2 || !info[0].IsNumber() || !info[1].IsNumber())
+    throw Napi::Error::New(env, "Usage: pty.read(fd, maximumBytes)");
+  int fd = info[0].As<Napi::Number>().Int32Value();
+  int maximum = info[1].As<Napi::Number>().Int32Value();
+  if (maximum < 1 || maximum > 65536)
+    throw Napi::Error::New(env, "PTY read bound is invalid");
+  std::unique_ptr<unsigned char[]> bytes(new unsigned char[maximum]);
+  ssize_t count = read(fd, bytes.get(), static_cast<size_t>(maximum));
+  Napi::Object result = Napi::Object::New(env);
+  if (count > 0) {
+    result.Set("status", Napi::String::New(env, "data"));
+    result.Set("bytes", Napi::Buffer<unsigned char>::Copy(env, bytes.get(), count));
+  } else if (count == 0) {
+    result.Set("status", Napi::String::New(env, "eof"));
+  } else if (errno == EAGAIN || errno == EWOULDBLOCK) {
+    result.Set("status", Napi::String::New(env, "would-block"));
+  } else if (errno == EIO) {
+    result.Set("status", Napi::String::New(env, "eio"));
+  } else {
+    throw Napi::Error::New(env, "PTY read failed");
+  }
+  return result;
+}
+
+Napi::Value PtyWrite(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  if (info.Length() != 2 || !info[0].IsNumber() || !info[1].IsBuffer())
+    throw Napi::Error::New(env, "Usage: pty.write(fd, bytes)");
+  int fd = info[0].As<Napi::Number>().Int32Value();
+  Napi::Buffer<unsigned char> bytes = info[1].As<Napi::Buffer<unsigned char>>();
+  if (bytes.Length() > 1048576)
+    throw Napi::Error::New(env, "PTY write bound is invalid");
+  ssize_t count = write(fd, bytes.Data(), bytes.Length());
+  Napi::Object result = Napi::Object::New(env);
+  if (count >= 0) {
+    result.Set("status", Napi::String::New(env,
+        static_cast<size_t>(count) == bytes.Length() ? "complete" : "partial"));
+    result.Set("bytesWritten", Napi::Number::New(env, count));
+  } else if (errno == EAGAIN || errno == EWOULDBLOCK) {
+    result.Set("status", Napi::String::New(env, "would-block"));
+    result.Set("bytesWritten", Napi::Number::New(env, 0));
+  } else {
+    throw Napi::Error::New(env, "PTY write failed");
+  }
+  return result;
+}
+
+Napi::Value PtyEof(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  if (info.Length() != 1 || !info[0].IsNumber())
+    throw Napi::Error::New(env, "Usage: pty.eof(fd)");
+  int fd = info[0].As<Napi::Number>().Int32Value();
+  struct termios mode;
+  if (tcgetattr(fd, &mode) == -1 || (mode.c_lflag & ICANON) == 0 ||
+      mode.c_cc[VEOF] == _POSIX_VDISABLE)
+    throw Napi::Error::New(env, "PTY EOF mode is not canonical");
+  unsigned char eof = mode.c_cc[VEOF];
+  ssize_t count = write(fd, &eof, 1);
+  if (count != 1)
+    throw Napi::Error::New(env, "PTY EOF delivery failed");
+  Napi::Object result = Napi::Object::New(env);
+  result.Set("canonical", Napi::Boolean::New(env, true));
+  result.Set("eofByte", Napi::Number::New(env, eof));
+  result.Set("bytesWritten", Napi::Number::New(env, 1));
+  return result;
 }
 
+Napi::Value PtyClose(const Napi::CallbackInfo& info) {
+  Napi::Env env(info.Env());
+  if (info.Length() != 1 || !info[0].IsNumber())
+    throw Napi::Error::New(env, "Usage: pty.close(fd)");
+  int fd = info[0].As<Napi::Number>().Int32Value();
+  if (close(fd) == -1)
+    throw Napi::Error::New(env, "PTY close failed");
+  return Napi::Boolean::New(env, true);
+}

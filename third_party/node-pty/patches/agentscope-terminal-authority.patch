+static bool
+pty_read_process_identity(pid_t pid, PtyProcessIdentity *identity) {
+  char path[64];
+  int path_bytes = snprintf(path, sizeof(path), "/proc/%d/stat", pid);
+  if (path_bytes < 1 || static_cast<size_t>(path_bytes) >= sizeof(path))
+    return false;
+  int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (fd == -1)
+    return false;
+  char bytes[4097];
+  size_t received = 0;
+  bool complete = true;
+  while (received < sizeof(bytes) - 1) {
+    ssize_t count = read(fd, bytes + received, sizeof(bytes) - 1 - received);
+    if (count > 0) {
+      received += static_cast<size_t>(count);
+      continue;
+    }
+    if (count == 0)
+      break;
+    if (errno == EINTR)
+      continue;
+    complete = false;
+    break;
+  }
+  if (received == sizeof(bytes) - 1) {
+    char extra;
+    ssize_t count;
+    do {
+      count = read(fd, &extra, 1);
+    } while (count == -1 && errno == EINTR);
+    if (count != 0)
+      complete = false;
+  }
+  if (close(fd) == -1)
+    complete = false;
+  if (!complete || received < 5)
+    return false;
+  bytes[received] = '\0';
+  char *command_end = strrchr(bytes, ')');
+  if (command_end == nullptr || command_end[1] != ' ' ||
+      command_end[2] == '\0')
+    return false;
+  char *save = nullptr;
+  char *token = strtok_r(command_end + 2, " ", &save);
+  if (token == nullptr || token[0] == '\0' || token[1] != '\0')
+    return false;
+  identity->state = token[0];
+  identity->parent = -1;
+  identity->start = 0;
+  for (int field = 1; field <= 19; field++) {
+    token = strtok_r(nullptr, " ", &save);
+    if (token == nullptr || token[0] == '\0')
+      return false;
+    char *end = nullptr;
+    errno = 0;
+    if (field == 19) {
+      if (token[0] == '-')
+        return false;
+      unsigned long long value = strtoull(token, &end, 10);
+      if (errno != 0 || end == token || *end != '\0')
+        return false;
+      identity->start = static_cast<uint64_t>(value);
+    } else {
+      long long value = strtoll(token, &end, 10);
+      if (errno != 0 || end == token || *end != '\0')
+        return false;
+      if (field == 1) {
+        if (value < 1 || value > INT_MAX)
+          return false;
+        identity->parent = static_cast<pid_t>(value);
+      }
+    }
+  }
+  return identity->start > 0 && identity->parent > 0;
+}

+static bool
+pty_close_once(int *fd) {
+  if (*fd < 0)
+    return true;
+  int owned = *fd;
+  *fd = -1;
+  if (pty_take_test_fault(5)) {
+    close(owned);
+    errno = EIO;
+    return false;
+  }
+  return close(owned) == 0;
+}
+
+static bool
+pty_join_failed_child(pid_t pid, int *master, int *status_fd,
+                      uint64_t deadline) {
+  bool certain = status_fd == nullptr || pty_close_once(status_fd);
+  certain = (master == nullptr || pty_close_once(master)) && certain;
+  bool forced_wait_uncertainty = pty_take_test_fault(6);
+  bool forced_signal_uncertainty = pty_take_test_fault(12);
+  if (pid <= 0)
+    return certain && !forced_wait_uncertainty && !forced_signal_uncertainty;
+  if (kill(-pid, SIGKILL) == -1 && errno != ESRCH)
+    certain = false;
+  if (kill(pid, SIGKILL) == -1 && errno != ESRCH)
+    certain = false;
+  while (true) {
+    pid_t joined = waitpid(pid, nullptr, WNOHANG);
+    if (joined == pid)
+      return certain && !forced_wait_uncertainty && !forced_signal_uncertainty;
+    if (joined == -1) {
+      if (errno == EINTR)
+        continue;
+      return errno == ECHILD
+          ? certain && !forced_wait_uncertainty && !forced_signal_uncertainty
+          : false;
+    }
+    int remaining = pty_remaining_milliseconds(deadline);
+    if (remaining == 0)
+      return false;
+    poll(nullptr, 0, remaining < 10 ? remaining : 10);
+  }
+}

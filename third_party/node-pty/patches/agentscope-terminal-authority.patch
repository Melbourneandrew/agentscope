+#if defined(AGENTSCOPE_PTY_TEST_FAULTS)
+static std::atomic<int> pty_test_fault(0);
+static bool
+pty_take_test_fault(int fault) {
+  int bit = 1 << fault;
+  return (pty_test_fault.fetch_and(~bit) & bit) != 0;
+}
+#else
+static bool
+pty_take_test_fault(int) {
+  return false;
+}
+#endif
+
+static bool
+pty_monotonic_now(uint64_t *now) {
+  struct timespec observation;
+  if (clock_gettime(CLOCK_MONOTONIC, &observation) == -1 ||
+      observation.tv_sec < 0 || observation.tv_nsec < 0)
+    return false;
+  *now = static_cast<uint64_t>(observation.tv_sec) * 1000000000ULL +
+         static_cast<uint64_t>(observation.tv_nsec);
+  return true;
+}
+
+static bool
+pty_string_code_units_within(napi_env env, napi_value value,
+                             size_t maximum) {
+  size_t code_units = 0;
+  return napi_get_value_string_utf16(env, value, nullptr, 0, &code_units) ==
+             napi_ok &&
+         code_units <= maximum;
+}
+
+static int
+pty_remaining_milliseconds(uint64_t deadline) {
+  uint64_t now;
+  if (!pty_monotonic_now(&now) || now >= deadline)
+    return 0;
+  uint64_t remaining = deadline - now;
+  uint64_t milliseconds = (remaining + 999999ULL) / 1000000ULL;
+  return milliseconds > static_cast<uint64_t>(INT_MAX)
+      ? INT_MAX
+      : static_cast<int>(milliseconds);
+}

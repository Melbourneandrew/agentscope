+struct TerminalHandle {
+  int fd;
+  dev_t device;
+  ino_t inode;
+  dev_t terminal_device;
+  uint64_t generation;
+  uint64_t deadline;
+  bool closed;
+  bool close_uncertain;
+};
+
+static std::atomic<uint64_t> terminal_generation(1);
+static const napi_type_tag terminal_handle_tag = {
+  0x41ea979b9c3e4f21ULL, 0xa63da807b28441d6ULL
+};
+
+static Napi::External<TerminalHandle>
+create_terminal_handle(Napi::Env env, int fd, uint64_t deadline,
+                       TerminalHandle **published = nullptr) {
+  struct stat identity;
+  if (pty_take_test_fault(2) || fd < 3 ||
+      fstat(fd, &identity) == -1 || !S_ISCHR(identity.st_mode) ||
+      isatty(fd) != 1)
+    throw Napi::Error::New(env, "PTY terminal identity is invalid");
+  TerminalHandle *handle = new TerminalHandle{
+    fd, identity.st_dev, identity.st_ino, identity.st_rdev,
+    terminal_generation.fetch_add(1), deadline, false, false
+  };
+  Napi::External<TerminalHandle> external;
+  try {
+    external = Napi::External<TerminalHandle>::New(env, handle,
+      [](Napi::Env, TerminalHandle *value) {
+        if (!value->closed) {
+          int owned = value->fd;
+          value->fd = -1;
+          value->generation = 0;
+          value->closed = true;
+          close(owned);
+        }
+        delete value;
+      });
+  } catch (...) {
+    delete handle;
+    throw;
+  }
+  external.TypeTag(&terminal_handle_tag);
+  if (published != nullptr)
+    *published = handle;
+  return external;
+}
+
+static TerminalHandle *
+require_terminal_handle(Napi::Env env, const Napi::Value& value,
+                        bool require_live_deadline = true) {
+  if (!value.IsExternal())
+    throw Napi::Error::New(env, "PTY terminal handle is not opaque authority");
+  Napi::External<TerminalHandle> external =
+      value.As<Napi::External<TerminalHandle>>();
+  if (!external.CheckTypeTag(&terminal_handle_tag))
+    throw Napi::Error::New(env, "PTY terminal handle type is not exact");
+  TerminalHandle *handle = external.Data();
+  struct stat identity;
+  if (handle == nullptr || handle->closed || handle->generation == 0 ||
+      fstat(handle->fd, &identity) == -1 || !S_ISCHR(identity.st_mode) ||
+      isatty(handle->fd) != 1 || identity.st_dev != handle->device ||
+      identity.st_ino != handle->inode ||
+      identity.st_rdev != handle->terminal_device ||
+      (require_live_deadline &&
+       pty_remaining_milliseconds(handle->deadline) == 0))
+    throw Napi::Error::New(env, "PTY terminal handle identity changed");
+  return handle;
+}

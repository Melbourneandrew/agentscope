+static bool
+pty_close_inherited_fds_except(int interpreter_fd, int script_fd,
+                               int exec_status_fd) {
+  DIR *directory = opendir("/proc/self/fd");
+  if (directory == nullptr)
+    return false;
+  int directory_fd = dirfd(directory);
+  bool complete = true;
+  struct dirent *entry;
+  while (true) {
+    errno = 0;
+    entry = readdir(directory);
+    if (entry == nullptr) {
+      if (errno != 0)
+        complete = false;
+      break;
+    }
+    // A successful intermediary operation may leave errno nonzero. Seed that
+    // exact condition so only the immediately following readdir owns errno.
+    errno = EINVAL;
+    char *end = nullptr;
+    long candidate = strtol(entry->d_name, &end, 10);
+    if (end == entry->d_name || *end != '\0' || candidate < 3 ||
+        candidate == interpreter_fd || candidate == script_fd ||
+        candidate == exec_status_fd ||
+        candidate == directory_fd)
+      continue;
+    if (candidate > INT_MAX || SetCloseOnExec(static_cast<int>(candidate)) == -1) {
+      complete = false;
+      break;
+    }
+  }
+  if (closedir(directory) == -1)
+    complete = false;
+  return complete;
+}

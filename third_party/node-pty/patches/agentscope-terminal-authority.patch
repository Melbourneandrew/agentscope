+[[noreturn]] static void
+pty_exec_fail(int status_fd, uint32_t stage, int error) {
+  ExecFailureReceipt receipt{stage, static_cast<int32_t>(error)};
+  const unsigned char *cursor =
+      reinterpret_cast<const unsigned char *>(&receipt);
+  size_t remaining = sizeof(receipt);
+  while (remaining > 0) {
+    ssize_t written = write(status_fd, cursor, remaining);
+    if (written > 0) {
+      cursor += written;
+      remaining -= static_cast<size_t>(written);
+    } else if (written == -1 && errno == EINTR) {
+      continue;
+    } else {
+      break;
+    }
+  }
+  _exit(1);
+}
+
+static bool
+pty_exec_succeeded(int status_fd, uint64_t deadline,
+                   ExecFailureReceipt *failure) {
+  struct pollfd observation{status_fd, POLLIN | POLLHUP, 0};
+  unsigned char *cursor = reinterpret_cast<unsigned char *>(failure);
+  size_t received = 0;
+  while (received < sizeof(*failure)) {
+    int remaining = pty_remaining_milliseconds(deadline);
+    if (remaining == 0)
+      return false;
+    int ready;
+    if (pty_take_test_fault(8)) {
+      errno = EINTR;
+      ready = -1;
+    } else {
+      ready = poll(&observation, 1, remaining);
+    }
+    if (ready == -1 && errno == EINTR)
+      continue;
+    if (ready != 1)
+      return false;
+    ssize_t count = read(status_fd, cursor + received,
+                         sizeof(*failure) - received);
+    if (count > 0) {
+      received += static_cast<size_t>(count);
+    } else if (count == 0) {
+      return received == 0;
+    } else if (errno == EINTR) {
+      continue;
+    } else if (errno == EAGAIN || errno == EWOULDBLOCK) {
+      continue;
+    } else {
+      return false;
+    }
+  }
+  return false;

{
  "name": "agentscope",
  "private": true,
  "version": "0.1.0",
  "description": "CLI-first coding-agent trace observability with extensible reporters.",
  "homepage": "https://melbourneandrew.github.io/agentscope/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melbourneandrew/agentscope.git"
  },
  "bugs": {
    "url": "https://github.com/Melbourneandrew/agentscope/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev:docs": "pnpm --filter @agentscope/docs dev",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @agentscope/core test && pnpm --filter @agentscope/testkit test",
    "test:integration": "docker compose -f tests/integration/docker-compose.yml up --build --exit-code-from integration",
    "test:integration:clean": "node tests/integration/clean.mjs",
    "test:integration:live": "pnpm --filter @agentscope/integration-live test",
    "typecheck": "nx run-many -t typecheck",
    "test:integration:runner": "node tests/integration/runner.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "node scripts/refuse-private-package.mjs",
    "verify:workspace": "node scripts/verify-workspace-policy.mjs",
    "prepare": "husky",
    "precommit": "lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ],
    "*.{css,json,md,mdx,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "^22.0.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}

{
  "name": "agentscope",
  "private": true,
  "version": "0.1.0",
  "description": "CLI-first coding-agent trace observability with extensible reporters.",
  "homepage": "https://melbourneandrew.github.io/agentscope/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Melbourneandrew/agentscope.git"
  },
  "bugs": {
    "url": "https://github.com/Melbourneandrew/agentscope/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm verify:targets && nx run-many -t build --all",
    "build:core-artifact-replay": "pnpm nx run @agentscope/core:build --skip-nx-cache && pnpm nx run @agentscope/core:build --skip-nx-cache",
    "dev:docs": "pnpm --filter @agentscope/docs dev",
    "lint": "pnpm verify:targets && pnpm verify:quality && eslint scripts '*.mjs' vitest.config.ts --max-warnings=0 && nx run-many -t lint --all",
    "test": "pnpm test:unit",
    "test:unit": "pnpm verify:targets && pnpm test:workspace-policy && nx run-many -t test --all",
    "coverage": "pnpm verify:targets && nx run-many -t coverage --all",
    "test:integration": "pnpm --filter @agentscope/integration integration",
    "typecheck": "pnpm verify:targets && nx run-many -t typecheck --all",
    "clean": "pnpm verify:targets && nx run-many -t clean --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:acceptance-evidence": "node scripts/verify-acceptance-evidence.mjs",
    "verify:acceptance-evidence:release": "node scripts/verify-acceptance-evidence.mjs --require-verified",
    "verify:release-lane-substrate": "node scripts/verify-release-lane-policy.mjs && vitest run --config vitest.config.ts scripts/__tests__/release-lane-substrate.test.mjs",
    "verify:cli-artifact": "pnpm --filter agentscope-cli verify:artifact",
    "verify:native-candidate": "node packages/destinations/local-sqlite/native-candidate/verify-artifact.mjs",
    "prepack": "node scripts/refuse-private-package.mjs",
    "verify:workspace": "pnpm verify:review-skill && pnpm verify:release-lane-substrate && pnpm --filter agentscope-cli verify:docs && node scripts/verify-workspace-policy.mjs && pnpm verify:targets",
    "verify:review-skill": "python3 .agents/skills/review-agentscope/scripts/validate_review_skill.py",
    "verify:targets": "node scripts/verify-workspace-targets.mjs",
    "test:workspace-policy": "node scripts/workspace-policy-runner.mjs",
    "verify:quality": "node scripts/verify-code-quality-policy.mjs",
    "verify:coverage-ratchet": "node scripts/verify-coverage-ratchet.mjs",
    "prepare": "husky",
    "precommit": "lint-staged",
    "prepush": "node scripts/prepush-affected.mjs"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored --fix"
    ],
    "*.{css,json,md,mdx,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "^22.0.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-package-arg": "^14.0.0",
    "nx": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}

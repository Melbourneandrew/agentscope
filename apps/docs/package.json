{
  "name": "@agentscope/docs",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app lib next.config.mjs postcss.config.mjs --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage --passWithNoTests",
    "clean": "node ../../scripts/clean-workspace.mjs",
    "prepack": "node ../../scripts/refuse-private-package.mjs"
  },
  "dependencies": {
    "fumadocs-core": "^16.14.4",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.4",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
